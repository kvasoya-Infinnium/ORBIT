# ============================================================
# Nexus configuration. Copy this file to ".env" and fill in.
# Anything you leave blank just makes that connector show as
# "not connected" — the app still runs.
# ============================================================

# ---- OpenAI (the agent's brain). Optional but recommended. ----
# Without it, Nexus falls back to a simple rule-based planner/summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: override the API endpoint (e.g. Azure OpenAI, a proxy, a regional host,
# or a local server like Ollama/LM Studio). Leave blank to use the default
# https://api.openai.com/v1
OPENAI_BASE_URL=

# ---- 1. Fileshare (multiple paths, comma-separated) ----
FILESHARE_PATHS=./data/fileshare

# ---- 2. Email (IMAP). Use an APP PASSWORD, not your real password. ----
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---- 3. AWS S3 (documents) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKETS=

# ---- 4. Slack. xoxp- (user) token = full search; xoxb- (bot) = history only. ----
SLACK_TOKEN=

# ---- 5. Zoho CRM (OAuth) ----
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DATA_CENTER=com

# ---- 6. GPT / AI Chat (OPTIONAL). local = use seeded JSON, live = real API. ----
AI_CHAT_MODE=local
CHATGPT_WORKSPACE_ID=
CHATGPT_COMPLIANCE_KEY=
